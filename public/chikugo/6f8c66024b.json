  "sentences": {
    "s1": [
      ["中納言", "中納言（が）"],
      ["参りたまひて、", "参上なさって、"],
      ["御扇", "（中宮に）扇（を）"],
      ["奉らせたまふに、", "差し上げなさる（とき）に、"],
      ["「隆家こそ", "「（私）隆家は、"],
      ["いみじき", "とてもすばらしい"],
      ["骨は", "骨を"],
      ["得てはべれ。", "手に入れております。"]
    ],
    "s2": [
      ["それを", "それに"],
      ["張らせて", "（紙を）張らせて"],
      ["参らせむと", "差し上げようと"],
      ["するに、", "思うが、"],
      ["おぼろけの", "ありふれた"],
      ["紙は", "紙は"],
      ["え張るまじければ、", "張ることができそうもないので、"],
      ["求めはべるなり。", "探しているのです。"]
    ],
    "s3": [
      ["」と", "」と"],
      ["申したまふ。", "申し上げなさる。"]
    ],
    "s4": [
      ["「いかやうにか", "「どのような（骨）で"],
      ["ある。", "あるのか。"]
    ],
    "s5": [
      ["」と", "」と、"],
      ["問ひきこえさせたまへば、", "（中宮が）お尋ね申し上げなさると、"],
      ["「すべて", "「全てが"],
      ["いみじうはべり。", "とてもすばらしゅうございます。"]
    ],
    "s6": [
      ["『さらに", "『まったく、"],
      ["まだ", "まだ"],
      ["見ぬ", "見たことのない"],
      ["骨の", "骨の"],
      ["さまなり。", "様子だ。"]
    ],
    "s7": [
      ["』となむ", "』と"],
      ["人々", "人々（も）"],
      ["申す。", "申し上げる。"]
    ],
    "s8": [
      ["まことに", "ほんとうに"],
      ["かばかりのは", "これほどのものは"],
      ["見えざりつ。", "見えなかった。"]
    ],
    "s9": [
      ["」と、", "」と、"],
      ["言高く", "声高に"],
      ["のたまへば、", "おっしゃるので、"],
      ["「さては、", "（私が）「それでは、"],
      ["扇のには", "扇の（骨）では"],
      ["あらで、", "なくて、"],
      ["くらげのななり。", "くらげの（骨）であるようですね。"]
    ],
    "s10": [
      ["」と", "」と"],
      ["聞こゆれば、", "申し上げると、"],
      ["「これは", "「これは"],
      ["隆家が", "（私）隆家が"],
      ["言に", "言ったことに"],
      ["してむ。", "してしまおう。"]
    ],
    "s11": [
      ["」とて、", "」とおっしゃって、"],
      ["笑ひたまふ。", "お笑いになる。"]
    ],
    "s12": [
      ["かやうの", "このような"],
      ["ことこそは、", "（自慢話めいた）ことは、"],
      ["かたはらいたき", "見苦しい"],
      ["ことの", "ことの"],
      ["うちに", "中に"],
      ["入れつべけれど、", "入れてしまうべきだが、"],
      ["「一つ", "「一言も"],
      ["な落としそ。", "書きもらさないでください。"]
    ],
    "s13": [
      ["」と", "」と"],
      ["言へば、", "（女房たちが）言うので、"],
      ["いかがはせむ。（）", "どのようにしようか、いやどうしようもない（まあ書いておこう）。"]
    ]
  }
